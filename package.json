{
  "name": "carpet",
  "version": "1.0.0",
  "description": "A local-first notch app for Mac that captures links, text, images and files, and lets you find them again with local AI search.",
  "main": "out/main/index.js",
  "author": "",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish=never"
  },
  "build": {
    "appId": "com.carpet.app",
    "productName": "Carpet",
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "identity": null,
      "hardenedRuntime": false
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
